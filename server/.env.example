# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://snippet:snippet@localhost:5432/snippet

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google Identity Services (must match the VITE_GOOGLE_CLIENT_ID used by the frontend)
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id

# SMTP email verification (required for email/password registration)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=Snippet <no-reply@example.com>

# Google AI
GOOGLE_AI_API_KEY=your-google-ai-api-key

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=20971520

# RAG
SIMILARITY_THRESHOLD=0.35
TOP_K_CHUNKS=5
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50

# Admin account provisioning
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Roster import
CURRENT_SEMESTER_NUMBER=
# Optional JSON array of verified subjects to import.
ACADEMIC_SUBJECTS_JSON=
