# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://snippet:snippet@localhost:5432/snippet

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google Identity Services (must match the VITE_GOOGLE_CLIENT_ID used by the frontend)
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id

# SMTP email verification (required for email/password registration)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=Snippet <no-reply@example.com>

# Google AI
GOOGLE_AI_API_KEY=your-google-ai-api-key

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=20971520

# RAG Configuration
SIMILARITY_THRESHOLD=0.35
TOP_K_CHUNKS=5
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50

# RAG Provider Selection (independent embedding and generation providers)
# Options for EMBEDDING_PROVIDER: 'gemini' (default if GOOGLE_AI_API_KEY set), 'ollama'
# Options for LLM_PROVIDER: 'google' (default if GOOGLE_AI_API_KEY set), 'ollama', 'openai', 'mock'
EMBEDDING_PROVIDER=gemini
LLM_PROVIDER=google

# Ollama Local Configuration (used when EMBEDDING_PROVIDER=ollama or LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_GENERATION_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=30000

# Admin account provisioning
ADMIN_EMAIL=
ADMIN_NAME=
# Optional for first provisioning; Render generates a one-time password when unset.
ADMIN_PASSWORD=

# Roster import
CURRENT_SEMESTER_NUMBER=
# Optional JSON array of verified subjects to import.
ACADEMIC_SUBJECTS_JSON=
