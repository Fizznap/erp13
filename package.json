{
  "name": "snippet",
  "private": true,
  "description": "AI-Powered Course Intelligence Platform",
  "scripts": {
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "setup": "cd server && npm install && cd ../client && npm install",
    "db:init": "cd server && node src/db/init.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
